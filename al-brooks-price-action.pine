
//@version=6
indicator("Al Brooks Price Action", overlay=true, max_labels_count=500, max_lines_count=500)

// ========================================
// INPUTS
// ========================================
// Display Options
showSecondEntryLong  = input.bool(true, "Show Second Entry Long",  group="Display")
showSecondEntryShort = input.bool(true, "Show Second Entry Short", group="Display")
showHigherLow        = input.bool(true, "Show Higher Low",         group="Display")
showLowerHigh        = input.bool(true, "Show Lower High",         group="Display")
showSwingPoints      = input.bool(true, "Show Swing Points",       group="Display")

// Alert Options
enableSecondEntryAlerts = input.bool(true,  "Enable Second Entry Alerts",   group="Alerts")
enableStructureAlerts   = input.bool(false, "Enable HL/LH Structure Alerts", group="Alerts", tooltip="Toggle on/off to visually test the impact of structure alerts and check for false positives.")

// Lookback Settings
swingLookback   = input.int(5,  "Swing Point Lookback",       minval=2, maxval=20, group="Settings")
secondEntryBars = input.int(10, "Second Entry Lookback Bars", minval=3, maxval=50, group="Settings")

// Second Entry Tolerance
pullbackTolerance = input.float(0.05, "Pullback Tolerance (%)", minval=0.001, maxval=1.0, step=0.01, group="Second Entry Tolerance", tooltip="How close a pullback must come to the prior swing to qualify as a 'test'. 0.05% ≈ 3 points on ES at 6000. Lower = stricter, fewer signals. Higher = looser, more signals.")

// ========================================
// SWING POINT DETECTION
// ========================================
isSwingHigh = ta.pivothigh(high, swingLookback, swingLookback)
isSwingLow  = ta.pivotlow(low,   swingLookback, swingLookback)

var float lastSwingHigh    = na
var int   lastSwingHighBar = na
var float lastSwingLow     = na
var int   lastSwingLowBar  = na
var float prevSwingHigh    = na
var float prevSwingLow     = na

if not na(isSwingHigh)
    prevSwingHigh    := lastSwingHigh
    lastSwingHigh    := high[swingLookback]
    lastSwingHighBar := bar_index - swingLookback

if not na(isSwingLow)
    prevSwingLow    := lastSwingLow
    lastSwingLow    := low[swingLookback]
    lastSwingLowBar := bar_index - swingLookback

// ========================================
// MARKET STRUCTURE (HL & LH only)
// ========================================
isHL = not na(isSwingLow)  and not na(prevSwingLow)  and low[swingLookback]  > prevSwingLow
isLH = not na(isSwingHigh) and not na(prevSwingHigh) and high[swingLookback] < prevSwingHigh

// ========================================
// SECOND ENTRY LOGIC
// ========================================
// Convert percentage to multiplier (e.g. 0.05% -> 0.0005)
tolMult = pullbackTolerance / 100.0

findSecondEntryLong() =>
    bool result = false
    if not na(lastSwingLow) and bar_index - lastSwingLowBar <= secondEntryBars
        int maxBars = math.min(secondEntryBars, bar_index - lastSwingLowBar)
        float upperBound = lastSwingLow * (1 + tolMult)
        float lowerBound = lastSwingLow * (1 - tolMult)
        for i = 1 to maxBars
            if low[i] <= upperBound and low[i] >= lowerBound
                if close > open and close > close[1]
                    result := true
                    break
    result

findSecondEntryShort() =>
    bool result = false
    if not na(lastSwingHigh) and bar_index - lastSwingHighBar <= secondEntryBars
        int maxBars = math.min(secondEntryBars, bar_index - lastSwingHighBar)
        float upperBound = lastSwingHigh * (1 + tolMult)
        float lowerBound = lastSwingHigh * (1 - tolMult)
        for i = 1 to maxBars
            if high[i] >= lowerBound and high[i] <= upperBound
                if close < open and close < close[1]
                    result := true
                    break
    result

secondEntryLongSetup     = findSecondEntryLong()
secondEntryLongConfirmed = secondEntryLongSetup[1] and close > high[1]

secondEntryShortSetup     = findSecondEntryShort()
secondEntryShortConfirmed = secondEntryShortSetup[1] and close < low[1]

// ========================================
// PLOTTING
// ========================================
// Swing points
plotshape(showSwingPoints and not na(isSwingHigh), "Swing High", shape.triangledown,
          location.abovebar, color.new(color.red, 30), offset=-swingLookback, size=size.tiny)
plotshape(showSwingPoints and not na(isSwingLow), "Swing Low", shape.triangleup,
          location.belowbar, color.new(color.green, 30), offset=-swingLookback, size=size.tiny)

// Market structure (HL & LH only)
plotshape(showHigherLow and isHL, "HL", shape.labelup, location.belowbar,
          color.new(color.green, 0), text="HL", textcolor=color.white, offset=-swingLookback, size=size.small)
plotshape(showLowerHigh and isLH, "LH", shape.labeldown, location.abovebar,
          color.new(color.red, 0), text="LH", textcolor=color.white, offset=-swingLookback, size=size.small)

// Second entries (confirmed only)
plotshape(showSecondEntryLong and secondEntryLongConfirmed, "2nd Entry Long",
          shape.labelup, location.belowbar, color.new(color.blue, 0), text="2L",
          textcolor=color.white, size=size.normal)

plotshape(showSecondEntryShort and secondEntryShortConfirmed, "2nd Entry Short",
          shape.labeldown, location.abovebar, color.new(color.orange, 0), text="2S",
          textcolor=color.white, size=size.normal)

// ========================================
// ALERTS
// ========================================
if enableSecondEntryAlerts
    if secondEntryLongConfirmed
        alert("Second Entry Long CONFIRMED - Consider entry", alert.freq_once_per_bar)
    if secondEntryShortConfirmed
        alert("Second Entry Short CONFIRMED - Consider entry", alert.freq_once_per_bar)

// Structure change alerts (HL/LH only, gated by toggle)
if enableStructureAlerts
    if isHL
        alert("Higher Low formed - Bullish structure", alert.freq_once_per_bar)
    if isLH
        alert("Lower High formed - Bearish structure", alert.freq_once_per_bar)

// ========================================
// ALERT CONDITIONS (for alert dialog)
// ========================================
alertcondition(secondEntryLongConfirmed,  title="2nd Entry Long Confirmed",  message="Second Entry Long CONFIRMED on {{ticker}} {{interval}}")
alertcondition(secondEntryShortConfirmed, title="2nd Entry Short Confirmed", message="Second Entry Short CONFIRMED on {{ticker}} {{interval}}")
alertcondition(isHL, title="Higher Low", message="Higher Low formed on {{ticker}} {{interval}}")
alertcondition(isLH, title="Lower High", message="Lower High formed on {{ticker}} {{interval}}")
