//@version=6
indicator("Daily Key Levels", overlay=true, max_lines_count=500, max_labels_count=500)

// ===== CONSTANTS =====
RTH_START_HOUR = 9
RTH_START_MIN = 30
RTH_END_HOUR = 16
RTH_END_MIN = 0
IB_END_HOUR = 10
IB_END_MIN = 30
ORB15_END_HOUR = 9
ORB15_END_MIN = 45
ORB30_END_HOUR = 10
ORB30_END_MIN = 0

// ===== INPUTS =====
// Display toggles
showPD = input.bool(true, "Show Previous Day", group="Display")
showPW = input.bool(true, "Show Previous Week", group="Display")
showGlobex = input.bool(true, "Show Globex (Overnight)", group="Display")
showIB = input.bool(true, "Show Initial Balance (9:30-10:30)", group="Display")
showORB15 = input.bool(true, "Show 15-Min ORB (9:45-9:59)", group="Display")
showORB30 = input.bool(true, "Show 30-Min ORB (10:00-10:29)", group="Display")

// Colors
colorPDH = input.color(color.new(color.red, 0), "PDH Color", group="Colors")
colorPDL = input.color(color.new(color.green, 0), "PDL Color", group="Colors")
colorPDO = input.color(color.new(color.blue, 0), "PDO Color", group="Colors")
colorPDC = input.color(color.new(color.purple, 0), "PDC Color", group="Colors")
colorPWH = input.color(color.new(color.purple, 0), "PWH Color", group="Colors")
colorPWL = input.color(color.new(color.purple, 0), "PWL Color", group="Colors")
colorGlobexH = input.color(color.new(color.gray, 0), "Globex High Color", group="Colors")
colorGlobexL = input.color(color.new(color.gray, 0), "Globex Low Color", group="Colors")
colorIBH = input.color(color.new(color.blue, 0), "IBH Color", group="Colors")
colorIBL = input.color(color.new(color.blue, 0), "IBL Color", group="Colors")
colorORB15H = input.color(color.new(color.orange, 0), "ORB-15 High Color", group="Colors")
colorORB15L = input.color(color.new(color.orange, 0), "ORB-15 Low Color", group="Colors")
colorORB30H = input.color(color.new(color.teal, 0), "ORB-30 High Color", group="Colors")
colorORB30L = input.color(color.new(color.teal, 0), "ORB-30 Low Color", group="Colors")

// Line Style & Width
lineStyle = input.string(title="Line Style", defval="Dashed", options=["Solid", "Dashed", "Dotted"], group="Line Style")
lineWidth = input.int(title="Line Width", defval=1, minval=1, maxval=4, group="Line Style")

getLineStyle() =>
    switch lineStyle
        "Solid" => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted

// ===== TIME VARIABLES =====
hourET = hour(time, "America/New_York")
minuteET = minute(time, "America/New_York")
newDay = ta.change(dayofmonth) != 0

// Session definitions
inRTH = (hourET == RTH_START_HOUR and minuteET >= RTH_START_MIN) or \
        (hourET > RTH_START_HOUR and hourET < RTH_END_HOUR) or \
        (hourET == RTH_END_HOUR and minuteET == RTH_END_MIN)

// Pre-market (Globex before RTH)
inGlobexBeforeRTH = (hourET == RTH_START_HOUR and minuteET < RTH_START_MIN) or \
                    (hourET < RTH_START_HOUR)

// After-hours (Globex after RTH)
inGlobexAfterRTH = (hourET == RTH_END_HOUR and minuteET > RTH_END_MIN) or \
                   (hourET > RTH_END_HOUR)

// Combined Globex session (pre-market + after-hours)
inGlobex = inGlobexBeforeRTH or inGlobexAfterRTH

// Session transition flags
sessionStarted = inRTH and not inRTH[1]

inIB = inRTH and (hourET == RTH_START_HOUR and minuteET >= RTH_START_MIN or hourET < IB_END_HOUR or \
                  (hourET == IB_END_HOUR and minuteET == 0))

// ORB-15 window: 9:30-9:45
inOrb15Window = inRTH and ((hourET == RTH_START_HOUR and minuteET >= RTH_START_MIN and minuteET < ORB15_END_MIN) or \
                           (hourET == ORB15_END_HOUR and minuteET < ORB15_END_MIN))
orb15Display = inRTH and ((hourET == ORB15_END_HOUR and minuteET >= ORB15_END_MIN and minuteET < 60) or \
                          (hourET == 10 and minuteET == 0))

// ORB-30 window: 9:30-10:00
inOrb30Window = inRTH and (hourET == RTH_START_HOUR and minuteET >= RTH_START_MIN or hourET < ORB30_END_HOUR)
orb30Display = inRTH and (hourET == ORB30_END_HOUR and minuteET < ORB30_END_MIN)

// IB display: only after 10:30am
ibDisplay = inRTH and (hourET > IB_END_HOUR or \
                       (hourET == IB_END_HOUR and minuteET >= IB_END_MIN) or \
                       (hourET == RTH_END_HOUR and minuteET == RTH_END_MIN))

// ===== CALCULATE PREVIOUS DAY HIGH/LOW/OPEN/CLOSE (RTH ONLY) =====
var float rthOpen = na
var float rthHigh = na
var float rthLow = na
var float rthClose = na
var float pdo = na
var float pdh = na
var float pdl = na
var float pdc = na

if newDay and not na(rthHigh)
    pdo := rthOpen
    pdh := rthHigh
    pdl := rthLow
    pdc := rthClose
    rthOpen := na
    rthHigh := na
    rthLow := na
    rthClose := na

if inRTH
    if na(rthOpen)
        rthOpen := open
        rthHigh := high
        rthLow := low
    else
        rthHigh := math.max(rthHigh, high)
        rthLow := math.min(rthLow, low)
    rthClose := close

// ===== CALCULATE PREVIOUS WEEK HIGH/LOW =====
// Use request.security with proper lookahead and no indexing on the request to avoid repainting
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high, low], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

// ===== CALCULATE GLOBEX HIGH/LOW (OVERNIGHT SESSION) =====
var float globexHigh = na
var float globexLow = na
var bool globexInitialized = false

// Reset Globex at start of RTH session
if sessionStarted
    globexHigh := na
    globexLow := na
    globexInitialized := false

// Track Globex high/low during Globex session
if inGlobex
    if not globexInitialized
        globexHigh := high
        globexLow := low
        globexInitialized := true
    else
        globexHigh := math.max(globexHigh, high)
        globexLow := math.min(globexLow, low)

// ===== CALCULATE INITIAL BALANCE (9:30-10:30) =====
var float ibHigh = na
var float ibLow = na
var bool ibInitialized = false

// Reset IB at start of RTH session
if sessionStarted
    ibHigh := na
    ibLow := na
    ibInitialized := false

// Track IB high/low during IB period (9:30-10:30)
if inIB
    if not ibInitialized
        ibHigh := high
        ibLow := low
        ibInitialized := true
    else
        ibHigh := math.max(ibHigh, high)
        ibLow := math.min(ibLow, low)

// ===== CALCULATE ORB-15 (9:30-9:45) =====
var float orb15High = na
var float orb15Low = na
var bool orb15Formed = false
var bool orb15Initialized = false

// Reset at start of RTH
if sessionStarted
    orb15High := na
    orb15Low := na
    orb15Formed := false
    orb15Initialized := false

// Capture ORB-15 range during formation window
if inOrb15Window
    if not orb15Initialized
        orb15High := high
        orb15Low := low
        orb15Initialized := true
    else
        orb15High := math.max(orb15High, high)
        orb15Low := math.min(orb15Low, low)

// Mark ORB-15 as formed when window ends
orb15Formed := orb15Formed or (not inOrb15Window and inOrb15Window[1] and orb15Initialized)

// ===== CALCULATE ORB-30 (9:30-10:00) =====
var float orb30High = na
var float orb30Low = na
var bool orb30Formed = false
var bool orb30Initialized = false

// Reset at start of RTH
if sessionStarted
    orb30High := na
    orb30Low := na
    orb30Formed := false
    orb30Initialized := false

// Capture ORB-30 range during formation window
if inOrb30Window
    if not orb30Initialized
        orb30High := high
        orb30Low := low
        orb30Initialized := true
    else
        orb30High := math.max(orb30High, high)
        orb30Low := math.min(orb30Low, low)

// Mark ORB-30 as formed when window ends
orb30Formed := orb30Formed or (not inOrb30Window and inOrb30Window[1] and orb30Initialized)

// ===== HELPER FUNCTION: CREATE LEVEL LINE =====
createLevelLine(lineVar, levelValue, levelColor, levelLabel, showToggle, displayCondition) =>
    if showToggle and displayCondition and not na(levelValue)
        line.delete(lineVar)
        lineVar := line.new(bar_index - 48, levelValue, bar_index, levelValue, 
            color=levelColor, width=lineWidth, style=getLineStyle(), extend=extend.right)
    lineVar

// ===== PLOT LEVELS AS RAYS =====
var line linePDH = na
var line linePDL = na
var line linePDO = na
var line linePDC = na
var line linePWH = na
var line linePWL = na
var line lineGlobexH = na
var line lineGlobexL = na
var line lineIBH = na
var line lineIBL = na
var line lineORB15H = na
var line lineORB15L = na
var line lineORB30H = na
var line lineORB30L = na

if barstate.islast
    // Previous Day levels
    linePDH := createLevelLine(linePDH, pdh, colorPDH, "PDH", showPD, true)
    linePDL := createLevelLine(linePDL, pdl, colorPDL, "PDL", showPD, true)
    linePDO := createLevelLine(linePDO, pdo, colorPDO, "PDO", showPD, true)
    linePDC := createLevelLine(linePDC, pdc, colorPDC, "PDC", showPD, true)

    // Previous Week levels
    linePWH := createLevelLine(linePWH, pwh, colorPWH, "PWH", showPW, true)
    linePWL := createLevelLine(linePWL, pwl, colorPWL, "PWL", showPW, true)

    // Globex levels
    lineGlobexH := createLevelLine(lineGlobexH, globexHigh, colorGlobexH, "GH", showGlobex, true)
    lineGlobexL := createLevelLine(lineGlobexL, globexLow, colorGlobexL, "GL", showGlobex, true)

    // IB levels (only display from 10:30am onwards)
    lineIBH := createLevelLine(lineIBH, ibHigh, colorIBH, "IBH", showIB, ibDisplay)
    lineIBL := createLevelLine(lineIBL, ibLow, colorIBL, "IBL", showIB, ibDisplay)

    // ORB-15 levels (display from 9:45 to 9:59)
    lineORB15H := createLevelLine(lineORB15H, orb15High, colorORB15H, "ORB-15-H", showORB15, orb15Display and orb15Formed)
    lineORB15L := createLevelLine(lineORB15L, orb15Low, colorORB15L, "ORB-15-L", showORB15, orb15Display and orb15Formed)

    // ORB-30 levels (display from 10:00 to 10:29)
    lineORB30H := createLevelLine(lineORB30H, orb30High, colorORB30H, "ORB-30-H", showORB30, orb30Display and orb30Formed)
    lineORB30L := createLevelLine(lineORB30L, orb30Low, colorORB30L, "ORB-30-L", showORB30, orb30Display and orb30Formed)

// ===== HELPER FUNCTION: CREATE LEVEL LABEL =====
createLevelLabel(labelVar, levelValue, levelColor, levelLabel, showToggle, displayCondition) =>
    if showToggle and displayCondition and not na(levelValue)
        label.delete(labelVar)
        labelVar := label.new(bar_index, levelValue, levelLabel, 
            style=label.style_label_down, color=levelColor, textcolor=color.white, size=size.normal)
    labelVar

// ===== LABELS =====
var label labelPDH = na
var label labelPDL = na
var label labelPDO = na
var label labelPDC = na
var label labelPWH = na
var label labelPWL = na
var label labelGlobexH = na
var label labelGlobexL = na
var label labelIBH = na
var label labelIBL = na
var label labelORB15H = na
var label labelORB15L = na
var label labelORB30H = na
var label labelORB30L = na

if barstate.islast
    // Previous Day labels
    labelPDH := createLevelLabel(labelPDH, pdh, colorPDH, "PDH", showPD, true)
    labelPDL := createLevelLabel(labelPDL, pdl, colorPDL, "PDL", showPD, true)
    labelPDO := createLevelLabel(labelPDO, pdo, colorPDO, "PDO", showPD, true)
    labelPDC := createLevelLabel(labelPDC, pdc, colorPDC, "PDC", showPD, true)

    // Previous Week labels
    labelPWH := createLevelLabel(labelPWH, pwh, colorPWH, "PWH", showPW, true)
    labelPWL := createLevelLabel(labelPWL, pwl, colorPWL, "PWL", showPW, true)

    // Globex labels
    labelGlobexH := createLevelLabel(labelGlobexH, globexHigh, colorGlobexH, "GH", showGlobex, true)
    labelGlobexL := createLevelLabel(labelGlobexL, globexLow, colorGlobexL, "GL", showGlobex, true)

    // IB labels (only display from 10:30am onwards)
    labelIBH := createLevelLabel(labelIBH, ibHigh, colorIBH, "IBH", showIB, ibDisplay)
    labelIBL := createLevelLabel(labelIBL, ibLow, colorIBL, "IBL", showIB, ibDisplay)

    // ORB-15 labels (display from 9:45 to 9:59)
    labelORB15H := createLevelLabel(labelORB15H, orb15High, colorORB15H, "ORB-15-H", showORB15, orb15Display and orb15Formed)
    labelORB15L := createLevelLabel(labelORB15L, orb15Low, colorORB15L, "ORB-15-L", showORB15, orb15Display and orb15Formed)

    // ORB-30 labels (display from 10:00 to 10:29)
    labelORB30H := createLevelLabel(labelORB30H, orb30High, colorORB30H, "ORB-30-H", showORB30, orb30Display and orb30Formed)
    labelORB30L := createLevelLabel(labelORB30L, orb30Low, colorORB30L, "ORB-30-L", showORB30, orb30Display and orb30Formed)
