//@version=6
indicator("Daily Key Levels", overlay=true, max_lines_count=500, max_labels_count=500)

// =============================================================
// =========================== INPUTS ===========================
// =============================================================
// Display toggles
showPD   = input.bool(true, "Show Previous Day", group="Display")
showPW   = input.bool(true, "Show Previous Week", group="Display")
showGlob = input.bool(true, "Show Globex (Overnight)", group="Display")
showIB   = input.bool(true, "Show Initial Balance (9:30-10:30)", group="Display")
showO15  = input.bool(true, "Show 15‑Min ORB (9:45-9:59)", group="Display")
showO30  = input.bool(true, "Show 30‑Min ORB (10:00-10:29)", group="Display")

// Colours – you can adjust defaults as you like
cPDH = input.color(color.red,    "PDH Color",    group="Colors")
cPDL = input.color(color.green,  "PDL Color",    group="Colors")
cPDO = input.color(color.blue,   "PDO Color",    group="Colors")
cPDC = input.color(color.purple, "PDC Color",    group="Colors")

cPWH = input.color(color.purple, "PWH Color",    group="Colors")
cPWL = input.color(color.purple, "PWL Color",    group="Colors")

cGlobH = input.color(color.gray,  "Globex High Color",  group="Colors")
cGlobL = input.color(color.gray,  "Globex Low Color",   group="Colors")

cIBH   = input.color(color.blue,  "IB High Color",      group="Colors")
cIBL   = input.color(color.blue,  "IB Low Color",       group="Colors")

cO15H  = input.color(color.orange,"ORB‑15 High Color",  group="Colors")
cO15L  = input.color(color.orange,"ORB‑15 Low Color",   group="Colors")

cO30H  = input.color(color.teal,  "ORB‑30 High Color",  group="Colors")
cO30L  = input.color(color.teal,  "ORB‑30 Low Color",   group="Colors")

// Line style & width (global for every level)
lineStyleStr = input.string("Dashed", "Line style", options=["Solid","Dashed","Dotted"], group="Line Style")
lineWidth    = input.int(1, "Line width", minval=1, maxval=4, group="Line Style")
lineStyle    = lineStyleStr == "Solid" ? line.style_solid : lineStyleStr == "Dotted" ? line.style_dotted : line.style_dashed

// =============================================================
// ====================== SESSION LOGIC ======================
// =============================================================
TZ      = "America/New_York"
newDay  = ta.change(time("D", TZ)) != 0   // first bar of a new NY day

// RTH (regular trading hours) – 09:30‑16:00 NY time
inRTH   = not na(time(timeframe.period, "0930-1600", TZ))
// Initial Balance (IB) – 09:30‑10:30 NY time
inIB    = not na(time(timeframe.period, "0930-1030", TZ))
// Globex (overnight) – everything outside RTH
inGlob  = not inRTH

// ORB‑15 (9:30‑9:45 formation, 9:45‑10:00 display)
inOrb15Form = not na(time(timeframe.period, "0930-0945", TZ))
showOrb15   = not na(time(timeframe.period, "0945-1000", TZ))

// ORB‑30 (9:30‑10:00 formation, 10:00‑10:30 display)
inOrb30Form = not na(time(timeframe.period, "0930-1000", TZ))
showOrb30   = not na(time(timeframe.period, "1000-1030", TZ))

// IB display – from 10:30 until the end of RTH
showIBDisp = not na(time(timeframe.period, "1030-1600", TZ))

// Detect the first bar of a new RTH session – used as line origin
var int rthStart = 0
if inRTH and not inRTH[1]
    rthStart := bar_index

// =============================================================
// =========================== TYPES ===========================
// =============================================================
type Level
    float  val   // current price level (na if not yet calculated)
    color  col   // colour used for line & label
    string txt   // label text (e.g. "PDH")
    line   ln    // line object (created once and then updated)
    label  lb    // label object (created once and then updated)
    bool   show  // user‑toggle (input.bool)

// =============================================================
// ========================= CALCULATIONS ======================
// =============================================================
// 1️⃣ Previous Day – only RTH values are considered
var float rthOpen = na, rthHigh = na, rthLow = na, rthClose = na
var float pdh = na, pdl = na, pdo = na, pdc = na

if newDay and not na(rthHigh)
    // roll yesterday's RTH data into the PD variables
    pdh := rthHigh
    pdl := rthLow
    pdo := rthOpen
    pdc := rthClose
    rthOpen := rthHigh := rthLow := rthClose := na

if inRTH
    // initialise on the first RTH bar
    rthOpen := na(rthOpen) ? open : rthOpen
    rthHigh := na(rthHigh) ? high : math.max(rthHigh, high)
    rthLow  := na(rthLow)  ? low  : math.min(rthLow,  low)
    rthClose := close

// 2️⃣ Previous Week – use security to fetch prior‑week high/low
pwh = request.security(syminfo.tickerid, "W", high[1])
pwl = request.security(syminfo.tickerid, "W", low[1])

// 3️⃣ Globex – track high/low during the overnight session
var float globHigh = na, globLow = na
if inGlob
    globHigh := na(globHigh) ? high : math.max(globHigh, high)
    globLow  := na(globLow)  ? low  : math.min(globLow, low)

// 4️⃣ Initial Balance – 09:30‑10:30
var float ibHigh = na, ibLow = na
if inIB
    ibHigh := na(ibHigh) ? high : math.max(ibHigh, high)
    ibLow  := na(ibLow)  ? low  : math.min(ibLow, low)

// 5️⃣ ORB‑15 – formation window 09:30‑09:45, display after 09:45
var float orb15High = na, orb15Low = na
var bool  orb15Formed = false
if inOrb15Form
    orb15High := na(orb15High) ? high : math.max(orb15High, high)
    orb15Low  := na(orb15Low)  ? low  : math.min(orb15Low, low)
else if not inOrb15Form and inOrb15Form[1] and not na(orb15High)
    orb15Formed := true

// 6️⃣ ORB‑30 – formation window 09:30‑10:00, display after 10:00
var float orb30High = na, orb30Low = na
var bool  orb30Formed = false
if inOrb30Form
    orb30High := na(orb30High) ? high : math.max(orb30High, high)
    orb30Low  := na(orb30Low)  ? low  : math.min(orb30Low, low)
else if not inOrb30Form and inOrb30Form[1] and not na(orb30High)
    orb30Formed := true

// =============================================================
// =========================== HELPERS =========================
// =============================================================
// Update (or create) a level's line & label. Called only on the last bar.
updateLevel(Level lvl, int startBar) =>
    if lvl.show and not na(lvl.val)
        if na(lvl.ln)
            // first time – create objects
            lvl.ln := line.new(startBar, lvl.val, bar_index, lvl.val,
                               color = lvl.col, width = lineWidth, style = lineStyle, extend = extend.right)
            lvl.lb := label.new(bar_index, lvl.val, lvl.txt,
                               style = label.style_label_down, color = lvl.col, textcolor = color.white, size = size.normal)
        else
            // update existing objects (no allocation)
            line.set_xy1(lvl.ln, startBar, lvl.val)
            line.set_xy2(lvl.ln, bar_index, lvl.val)
            line.set_color(lvl.ln, lvl.col)
            label.set_xy(lvl.lb, bar_index, lvl.val)
            label.set_color(lvl.lb, lvl.col)
    else
        // hide when not applicable
        line.delete(lvl.ln)
        label.delete(lvl.lb)
        lvl.ln := na
        lvl.lb := na

// =============================================================
// ======================= LEVEL DECLARATIONS ==================
// =============================================================
var Level lPDH = Level.new(pdh, cPDH, "PDH", na, na, showPD)
var Level lPDL = Level.new(pdl, cPDL, "PDL", na, na, showPD)
var Level lPDO = Level.new(pdo, cPDO, "PDO", na, na, showPD)
var Level lPDC = Level.new(pdc, cPDC, "PDC", na, na, showPD)

var Level lPWH = Level.new(pwh, cPWH, "PWH", na, na, showPW)
var Level lPWL = Level.new(pwl, cPWL, "PWL", na, na, showPW)

var Level lGlobH = Level.new(globHigh, cGlobH, "GH", na, na, showGlob)
var Level lGlobL = Level.new(globLow,  cGlobL, "GL", na, na, showGlob)

var Level lIBH = Level.new(ibHigh, cIBH, "IBH", na, na, showIB)
var Level lIBL = Level.new(ibLow,  cIBL, "IBL", na, na, showIB)

var Level lO15H = Level.new(orb15High, cO15H, "ORB‑15‑H", na, na, showO15)
var Level lO15L = Level.new(orb15Low,  cO15L, "ORB‑15‑L", na, na, showO15)

var Level lO30H = Level.new(orb30High, cO30H, "ORB‑30‑H", na, na, showO30)
var Level lO30L = Level.new(orb30Low,  cO30L, "ORB‑30‑L", na, na, showO30)

// =============================================================
// ============================ RENDER ==========================
// =============================================================
if barstate.islast
    // Refresh the dynamic values (the Level structs hold references)
    lPDH.val := pdh
    lPDL.val := pdl
    lPDO.val := pdo
    lPDC.val := pdc
    lPWH.val := pwh
    lPWL.val := pwl
    lGlobH.val := globHigh
    lGlobL.val := globLow
    lIBH.val := ibHigh
    lIBL.val := ibLow
    lO15H.val := orb15High
    lO15L.val := orb15Low
    lO30H.val := orb30High
    lO30L.val := orb30Low

    // Determine if a level should be visible at this moment (time‑dependent ones)
    lIBH.show := showIB and showIBDisp
    lIBL.show := showIB and showIBDisp
    lO15H.show := showO15 and showOrb15 and orb15Formed
    lO15L.show := showO15 and showOrb15 and orb15Formed
    lO30H.show := showO30 and showOrb30 and orb30Formed
    lO30L.show := showO30 and showOrb30 and orb30Formed

    // Draw / update all levels
    updateLevel(lPDH, rthStart)
    updateLevel(lPDL, rthStart)
    updateLevel(lPDO, rthStart)
    updateLevel(lPDC, rthStart)
    updateLevel(lPWH, rthStart)
    updateLevel(lPWL, rthStart)
    updateLevel(lGlobH, rthStart)
    updateLevel(lGlobL, rthStart)
    updateLevel(lIBH, rthStart)
    updateLevel(lIBL, rthStart)
    updateLevel(lO15H, rthStart)
    updateLevel(lO15L, rthStart)
    updateLevel(lO30H, rthStart)
    updateLevel(lO30L, rthStart)
