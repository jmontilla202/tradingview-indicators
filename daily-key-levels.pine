//@version=6
indicator("Daily Key Levels", overlay=true, max_lines_count=500, max_labels_count=500)

// ===== INPUTS =====
// Display toggles — individual level on/off
showPDH = input.bool(true, "PDH (Previous Day High)", group="Display")
showPDL = input.bool(true, "PDL (Previous Day Low)", group="Display")
showPWH = input.bool(true, "PWH (Previous Week High)", group="Display")
showPWL = input.bool(true, "PWL (Previous Week Low)", group="Display")
showIBH = input.bool(true, "IBH (Initial Balance High)", group="Display")
showIBL = input.bool(true, "IBL (Initial Balance Low)", group="Display")
showIBM = input.bool(true, "IBM (Initial Balance Middle)", group="Display")
showORB30H = input.bool(true, "ORB-30 High", group="Display")
showORB30L = input.bool(true, "ORB-30 Low", group="Display")
showOVH = input.bool(true, "OVH (Overnight High)", group="Display")
showOVL = input.bool(true, "OVL (Overnight Low)", group="Display")
showRTHO = input.bool(true, "Open (RTH)", group="Display")
showIBConf = input.bool(true, "IB Combined Confluence", group="Display")
showVWAP = input.bool(true, "RTH VWAP", group="Display")
showEMA8 = input.bool(true, "EMA 8", group="Display")
showEMA21 = input.bool(true, "EMA 21", group="Display")

// Colors
colorPDH = input.color(color.new(color.red, 0), "PDH Color", group="Colors")
colorPDL = input.color(color.new(color.green, 0), "PDL Color", group="Colors")
colorPWH = input.color(color.new(color.purple, 0), "PWH Color", group="Colors")
colorPWL = input.color(color.new(color.purple, 0), "PWL Color", group="Colors")
colorIBH = input.color(color.new(color.blue, 0), "IBH Color", group="Colors")
colorIBL = input.color(color.new(color.blue, 0), "IBL Color", group="Colors")
colorIBM = input.color(color.new(color.blue, 60), "IBM Color", group="Colors")
colorORB30H = input.color(color.new(color.teal, 0), "ORB-30 High Color", group="Colors")
colorORB30L = input.color(color.new(color.teal, 0), "ORB-30 Low Color", group="Colors")
colorOVH = input.color(color.new(color.orange, 0), "OVH Color", group="Colors")
colorOVL = input.color(color.new(color.orange, 0), "OVL Color", group="Colors")
colorRTHO = input.color(color.new(color.aqua, 0), "Open (RTH) Color", group="Colors")
colorIBConfBull = input.color(color.new(color.lime, 0), "IB Confluence Bullish", group="Colors")
colorIBConfBear = input.color(color.new(color.fuchsia, 0), "IB Confluence Bearish", group="Colors")
colorVWAP = input.color(color.new(color.maroon, 0), "VWAP Color", group="Colors")
colorEMA8 = input.color(color.new(color.white, 0), "EMA 8 Color", group="Colors")
colorEMA21 = input.color(color.new(color.gray, 0), "EMA 21 Color", group="Colors")

// Line Style & Width
lineStyle = input.string(title="Line Style", defval="Dashed", options=["Solid", "Dashed", "Dotted"], group="Line Style")
lineWidth = input.int(title="Line Width", defval=1, minval=1, maxval=4, group="Line Style")
vwapLineStyle = input.string(title="VWAP Line Style", defval="Solid", options=["Solid", "Dashed", "Dotted"], group="Line Style")
ema8LineStyle  = input.string(title="EMA 8 Line Style",  defval="Solid", options=["Solid", "Dashed", "Dotted"], group="Line Style")
ema21LineStyle = input.string(title="EMA 21 Line Style", defval="Solid", options=["Solid", "Dashed", "Dotted"], group="Line Style")

// Label position — plain-text floating labels above each level line.
// Pulls the labels away from the line so they don't compete with price action.
labelOffset     = input.int(5, "Label Offset (bars right of current)", minval=0, maxval=50, group="Labels")
labelTicksAbove = input.int(4, "Label Vertical Offset (ticks above line)", minval=0, maxval=50, group="Labels")
labelSize       = input.string("Normal", "Label Font Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group="Labels")
labelX          = bar_index + labelOffset
tickOffset      = syminfo.mintick * labelTicksAbove

getLineStyle() =>
    switch lineStyle
        "Solid" => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted

getVwapLineStyle() =>
    switch vwapLineStyle
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted

getEma8LineStyle() =>
    switch ema8LineStyle
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted

getEma21LineStyle() =>
    switch ema21LineStyle
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted

getLabelSize() =>
    switch labelSize
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge

// ===== TIME VARIABLES (DEFINED ONCE) =====
hourET = hour(time, "America/New_York")
minuteET = minute(time, "America/New_York")
// Rising edge of the 18:00 ET bar → Globex open. PDH/PDL resets here using
// the RTH session that just closed at 16:00 ET. Works across timeframes
// (1m, 5m, 1H, etc.) because it detects the transition, not a flat match.
is1800     = hourET == 18 and minuteET == 0
globexOpen = is1800 and not is1800[1] // ↑ fallback to false on first bar

// Session definitions
inRTH = (hourET == 9 and minuteET >= 30) or (hourET > 9 and hourET < 16) or (hourET == 16 and minuteET == 0)
inIB = inRTH and ((hourET == 9 and minuteET >= 30) or (hourET == 10 and minuteET < 30))

// ORB-30 window: 9:30-10:00
inOrb30Window = inRTH and ((hourET == 9 and minuteET >= 30) or (hourET == 10 and minuteET == 0))
orb30Display = inRTH and ((hourET == 10 and minuteET >= 0 and minuteET < 30))

// IB display: only after 10:30am
ibDisplay = inRTH and ((hourET == 10 and minuteET >= 30) or (hourET > 10) or (hourET == 16 and minuteET == 0))

// Overnight window: 9:00pm ET to 9:29am ET (Globex/Asian/London/premarket)
inOvernightWindow = (hourET >= 21) or (hourET < 9) or (hourET == 9 and minuteET < 30)

// ===== CALCULATE PREVIOUS DAY HIGH/LOW =====
// PDH/PDL = today's RTH range (9:30–16:00 ET), snapshotted at 18:00 ET
// (Globex open). At the Globex-open bar, rthHigh/rthLow still hold the
// just-completed RTH range — they aren't touched again until the next
// RTH session begins, so the snapshot captures the correct values.
var float rthOpen = na
var float rthHigh = na
var float rthLow = na
var float pdh = na
var float pdl = na

if globexOpen and not na(rthHigh)
    pdh := rthHigh
    pdl := rthLow
    rthOpen := na
    rthHigh := na
    rthLow := na

if inRTH
    if na(rthOpen)
        rthOpen := open
        rthHigh := high
        rthLow := low
    else
        rthHigh := math.max(rthHigh, high)
        rthLow := math.min(rthLow, low)

// ===== CALCULATE PREVIOUS WEEK HIGH/LOW =====
float pwh = request.security(syminfo.tickerid, "W", high[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
float pwl = request.security(syminfo.tickerid, "W", low[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

// ===== CALCULATE INITIAL BALANCE (9:30-10:30) =====
var float ibHigh = na
var float ibLow = na

// Reset IB at start of RTH session
if inRTH and not inRTH[1]
    ibHigh := na
    ibLow := na

// Track IB high/low during IB period (9:30-10:30)
if inIB
    if na(ibHigh)
        ibHigh := high
        ibLow := low
    else
        ibHigh := math.max(ibHigh, high)
        ibLow := math.min(ibLow, low)

// ===== IB COMBINED CONFLUENCE (High/Low Order + Midpoint Close) =====
// Track which extreme was set first vs last during IB formation
var int   ibHighBar    = na      // bar_index when IB high was established
var int   ibLowBar     = na      // bar_index when IB low was established
var float ibClosePrice = na      // close price of the last bar in IB (10:29 bar)
var float ibMid        = na      // midpoint of IB range — shared by confluence logic and IBM plot
var bool  ibConfBull   = false   // dual confluence → expect high break
var bool  ibConfBear   = false   // dual confluence → expect low break
var bool  ibConfSet    = false   // true once IB closes and confluence is evaluated
var string ibConfMidLabel = ""   // for tooltip detail
var string ibConfHLLabel  = ""   // for tooltip detail

// Reset at RTH open
if inRTH and not inRTH[1]
    ibHighBar    := na
    ibLowBar     := na
    ibClosePrice := na
    ibMid        := na
    ibConfBull   := false
    ibConfBear   := false
    ibConfSet    := false
    ibConfMidLabel := ""
    ibConfHLLabel  := ""

// During IB: track the bar_index each time a new high or low is printed
if inIB
    if na(ibHighBar)
        // First bar of IB — initialise both
        ibHighBar := bar_index
        ibLowBar  := bar_index
    else
        if high > ibHigh[1] or (high == ibHigh and bar_index > ibHighBar)
            ibHighBar := bar_index
        if low < ibLow[1] or (low == ibLow and bar_index > ibLowBar)
            ibLowBar := bar_index
    ibClosePrice := close   // continuously update; final value = IB close

// Evaluate confluence at the transition out of IB (first bar after 10:30)
if ibDisplay and not ibDisplay[1] and not na(ibHigh) and not na(ibLow) and not na(ibClosePrice)
    ibConfSet := true
    ibMid := (ibHigh + ibLow) / 2.0

    // Confluence 1 — Midpoint: did IB close above or below mid?
    bool closedAboveMid = ibClosePrice > ibMid
    bool closedBelowMid = ibClosePrice < ibMid

    // Confluence 2 — HL Order: which extreme was set last?
    bool lowFirstHighLast = ibHighBar > ibLowBar   // high was set AFTER low → bullish
    bool highFirstLowLast = ibLowBar > ibHighBar    // low was set AFTER high → bearish

    // Combined confluence
    ibConfBull := closedAboveMid and lowFirstHighLast
    ibConfBear := closedBelowMid and highFirstLowLast

    // Labels for tooltip
    ibConfMidLabel := closedAboveMid ? "Above Mid ✓" : closedBelowMid ? "Below Mid ✓" : "At Mid ⚊"
    ibConfHLLabel  := lowFirstHighLast ? "Low 1st → High Last ✓" : highFirstLowLast ? "High 1st → Low Last ✓" : "Simultaneous ⚊"

// ===== CALCULATE ORB-30 (9:30-10:00) =====
var float orb30High = na
var float orb30Low = na
var bool orb30Formed = false

// Reset at start of RTH
if inRTH and not inRTH[1]
    orb30High := na
    orb30Low := na
    orb30Formed := false

// Capture ORB-30 range during formation window
if inOrb30Window
    if na(orb30High)
        orb30High := high
        orb30Low := low
    else
        orb30High := math.max(orb30High, high)
        orb30Low := math.min(orb30Low, low)

// Mark ORB-30 as formed when window ends
if not inOrb30Window and inOrb30Window[1] and not na(orb30High)
    orb30Formed := true

// ===== CALCULATE OVERNIGHT HIGH/LOW (9:00pm - 9:29am ET) =====
var float ovh = na
var float ovl = na

if inOvernightWindow and not inOvernightWindow[1]
    ovh := na
    ovl := na

if inOvernightWindow
    if na(ovh)
        ovh := high
        ovl := low
    else
        ovh := math.max(ovh, high)
        ovl := math.min(ovl, low)

// ===== RTH VWAP =====
// Custom VWAP reset on RTH open. Accumulates hlc3*volume and volume across
// the session, then divides. Reset fires on the first RTH bar; subsequent
// RTH bars accumulate. Outside RTH the line is hidden (inRTH gate).
var float cumPV  = 0.0
var float cumVol = 0.0
if inRTH and not inRTH[1]
    cumPV  := 0.0
    cumVol := 0.0
if inRTH
    cumPV  += volume * hlc3
    cumVol += volume
float rthVwap = cumVol != 0 ? cumPV / cumVol : na

// ===== EMA 8 / EMA 21 =====
float ema8  = ta.ema(close, 8)
float ema21 = ta.ema(close, 21)

// ===== MOVING-AVERAGE CURVES (continuous polylines) =====
// RTH VWAP / EMA 8 / EMA 21 follow their per-bar value like a moving average,
// NOT a rigid horizontal ray like the static levels below. We accumulate
// chart.points and rebuild one polyline per bar so style changes apply
// immediately. The buffer is capped at 500 points to bound memory and the
// polyline is rebuilt from the buffer every bar (delete → create).
var polyline polyVwap = na
var chart.point[] vwapPts = array.new<chart.point>(0)

if showVWAP
    if inRTH
        if not inRTH[1]
            array.clear(vwapPts)              // RTH open → drop prior session
        if not na(rthVwap)
            array.push(vwapPts, chart.point.from_index(bar_index, rthVwap))
        while array.size(vwapPts) > 500
            array.shift(vwapPts)
        polyline.delete(polyVwap)
        if array.size(vwapPts) >= 2
            polyVwap := polyline.new(vwapPts, xloc=xloc.bar_index, line_color=colorVWAP, line_width=lineWidth, line_style=getVwapLineStyle())
    else
        polyline.delete(polyVwap)             // hide off-hours
        array.clear(vwapPts)
else
    polyline.delete(polyVwap)
    array.clear(vwapPts)

var polyline polyEma8 = na
var chart.point[] ema8Pts = array.new<chart.point>(0)

if showEMA8
    if not na(ema8)
        array.push(ema8Pts, chart.point.from_index(bar_index, ema8))
    while array.size(ema8Pts) > 500
        array.shift(ema8Pts)
    polyline.delete(polyEma8)
    if array.size(ema8Pts) >= 2
        polyEma8 := polyline.new(ema8Pts, xloc=xloc.bar_index, line_color=colorEMA8, line_width=lineWidth, line_style=getEma8LineStyle())
else
    polyline.delete(polyEma8)
    array.clear(ema8Pts)

var polyline polyEma21 = na
var chart.point[] ema21Pts = array.new<chart.point>(0)

if showEMA21
    if not na(ema21)
        array.push(ema21Pts, chart.point.from_index(bar_index, ema21))
    while array.size(ema21Pts) > 500
        array.shift(ema21Pts)
    polyline.delete(polyEma21)
    if array.size(ema21Pts) >= 2
        polyEma21 := polyline.new(ema21Pts, xloc=xloc.bar_index, line_color=colorEMA21, line_width=lineWidth, line_style=getEma21LineStyle())
else
    polyline.delete(polyEma21)
    array.clear(ema21Pts)

// ===== PLOT LEVELS AS RAYS =====
var line linePDH = na
var line linePDL = na
var line linePWH = na
var line linePWL = na
var line lineIBH = na
var line lineIBL = na
var line lineIBM = na
var line lineORB30H = na
var line lineORB30L = na
var line lineOVH = na
var line lineOVL = na
var line lineRTHO = na

if barstate.islast
    startBar = bar_index - 48

    // Previous Day levels
    if showPDH and not na(pdh)
        line.delete(linePDH)
        linePDH := line.new(startBar, pdh, bar_index, pdh, color=colorPDH, width=lineWidth, style=getLineStyle(), extend=extend.right)
    if showPDL and not na(pdl)
        line.delete(linePDL)
        linePDL := line.new(startBar, pdl, bar_index, pdl, color=colorPDL, width=lineWidth, style=getLineStyle(), extend=extend.right)

    // Previous Week levels
    if showPWH and not na(pwh)
        line.delete(linePWH)
        linePWH := line.new(startBar, pwh, bar_index, pwh, color=colorPWH, width=lineWidth, style=getLineStyle(), extend=extend.right)
    if showPWL and not na(pwl)
        line.delete(linePWL)
        linePWL := line.new(startBar, pwl, bar_index, pwl, color=colorPWL, width=lineWidth, style=getLineStyle(), extend=extend.right)

    // IB levels (only display from 10:30am onwards)
    if showIBH and ibDisplay and not na(ibHigh)
        line.delete(lineIBH)
        lineIBH := line.new(startBar, ibHigh, bar_index, ibHigh, color=colorIBH, width=lineWidth, style=getLineStyle(), extend=extend.right)
    if showIBL and ibDisplay and not na(ibLow)
        line.delete(lineIBL)
        lineIBL := line.new(startBar, ibLow, bar_index, ibLow, color=colorIBL, width=lineWidth, style=getLineStyle(), extend=extend.right)
    if showIBM and ibDisplay and not na(ibMid)
        line.delete(lineIBM)
        lineIBM := line.new(startBar, ibMid, bar_index, ibMid, color=colorIBM, width=lineWidth, style=getLineStyle(), extend=extend.right)

    // ORB-30 levels (display from 10:00 to 10:29)
    if showORB30H and orb30Display and orb30Formed and not na(orb30High)
        line.delete(lineORB30H)
        lineORB30H := line.new(startBar, orb30High, bar_index, orb30High, color=colorORB30H, width=lineWidth, style=getLineStyle(), extend=extend.right)
    if showORB30L and orb30Display and orb30Formed and not na(orb30Low)
        line.delete(lineORB30L)
        lineORB30L := line.new(startBar, orb30Low, bar_index, orb30Low, color=colorORB30L, width=lineWidth, style=getLineStyle(), extend=extend.right)

    // Overnight High/Low levels (display only during RTH 9:30-16:00)
    if showOVH and inRTH and not na(ovh)
        line.delete(lineOVH)
        lineOVH := line.new(startBar, ovh, bar_index, ovh, color=colorOVH, width=lineWidth, style=getLineStyle(), extend=extend.right)
    if showOVL and inRTH and not na(ovl)
        line.delete(lineOVL)
        lineOVL := line.new(startBar, ovl, bar_index, ovl, color=colorOVL, width=lineWidth, style=getLineStyle(), extend=extend.right)

    // Open (RTH) (display only during RTH 9:30-16:00)
    if showRTHO and inRTH and not na(rthOpen)
        line.delete(lineRTHO)
        lineRTHO := line.new(startBar, rthOpen, bar_index, rthOpen, color=colorRTHO, width=lineWidth, style=getLineStyle(), extend=extend.right)

    // RTH VWAP / EMA 8 / EMA 21 are drawn as continuous polylines (see
    // "MOVING-AVERAGE CURVES" section above) so they aren't rendered here.

// ===== IB CONFLUENCE VISUAL CUE =====
// Plain-text marker at the probable break level when dual confluence fires
var label labelIBConfBull = na
var label labelIBConfBear = na

if barstate.islast
    label.delete(labelIBConfBull)
    label.delete(labelIBConfBear)

    if showIBConf and ibConfSet and ibDisplay
        if ibConfBull and not na(ibHigh)
            string tip = "IB DUAL CONFLUENCE → HIGH BREAK\n" +
                 "─────────────────────────\n" +
                 "Midpoint: " + ibConfMidLabel + "\n" +
                 "HL Order: " + ibConfHLLabel + "\n" +
                 "─────────────────────────\n" +
                 "~74% break before noon\n" +
                 "~84% break before 4pm\n" +
                 "─────────────────────────\n" +
                 "Look for 40-60% pullback\n" +
                 "into unmitigated leg for\n" +
                 "long entry to IBH target"
            labelIBConfBull := label.new(labelX, ibHigh + tickOffset, "⬆ IB\nDUAL",
                 style=label.style_none,
                 color=color.new(color.white, 100),
                 textcolor=colorIBConfBull,
                 size=getLabelSize(),
                 tooltip=tip)

        if ibConfBear and not na(ibLow)
            string tip = "IB DUAL CONFLUENCE → LOW BREAK\n" +
                 "─────────────────────────\n" +
                 "Midpoint: " + ibConfMidLabel + "\n" +
                 "HL Order: " + ibConfHLLabel + "\n" +
                 "─────────────────────────\n" +
                 "~74% break before noon\n" +
                 "~84% break before 4pm\n" +
                 "─────────────────────────\n" +
                 "Look for 40-60% pullback\n" +
                 "into unmitigated leg for\n" +
                 "short entry to IBL target"
            labelIBConfBear := label.new(labelX, ibLow + tickOffset, "⬇ IB\nDUAL",
                 style=label.style_none,
                 color=color.new(color.white, 100),
                 textcolor=colorIBConfBear,
                 size=getLabelSize(),
                 tooltip=tip)

// ===== LABELS =====
// Plain-text floating labels above each level line. Configurable x-offset
// (bars right of current bar) and y-offset (ticks above the line) keep the
// labels out of the way of price action at the level.
var label labelPDH = na
var label labelPDL = na
var label labelPWH = na
var label labelPWL = na
var label labelIBH = na
var label labelIBL = na
var label labelIBM = na
var label labelORB30H = na
var label labelORB30L = na
var label labelOVH = na
var label labelOVL = na
var label labelRTHO = na

if barstate.islast
    // Previous Day labels
    if showPDH and not na(pdh)
        label.delete(labelPDH)
        labelPDH := label.new(labelX, pdh + tickOffset, "PDH", style=label.style_none, color=color.new(color.white, 100), textcolor=colorPDH, size=getLabelSize())
    if showPDL and not na(pdl)
        label.delete(labelPDL)
        labelPDL := label.new(labelX, pdl + tickOffset, "PDL", style=label.style_none, color=color.new(color.white, 100), textcolor=colorPDL, size=getLabelSize())

    // Previous Week labels
    if showPWH and not na(pwh)
        label.delete(labelPWH)
        labelPWH := label.new(labelX, pwh + tickOffset, "PWH", style=label.style_none, color=color.new(color.white, 100), textcolor=colorPWH, size=getLabelSize())
    if showPWL and not na(pwl)
        label.delete(labelPWL)
        labelPWL := label.new(labelX, pwl + tickOffset, "PWL", style=label.style_none, color=color.new(color.white, 100), textcolor=colorPWL, size=getLabelSize())

    // IB labels (only display from 10:30am onwards)
    if showIBH and ibDisplay and not na(ibHigh)
        label.delete(labelIBH)
        labelIBH := label.new(labelX, ibHigh + tickOffset, "IBH", style=label.style_none, color=color.new(color.white, 100), textcolor=colorIBH, size=getLabelSize())
    if showIBL and ibDisplay and not na(ibLow)
        label.delete(labelIBL)
        labelIBL := label.new(labelX, ibLow + tickOffset, "IBL", style=label.style_none, color=color.new(color.white, 100), textcolor=colorIBL, size=getLabelSize())
    if showIBM and ibDisplay and not na(ibMid)
        label.delete(labelIBM)
        labelIBM := label.new(labelX, ibMid + tickOffset, "IBM", style=label.style_none, color=color.new(color.white, 100), textcolor=colorIBM, size=getLabelSize())

    // ORB-30 labels (display from 10:00 to 10:29)
    if showORB30H and orb30Display and orb30Formed and not na(orb30High)
        label.delete(labelORB30H)
        labelORB30H := label.new(labelX, orb30High + tickOffset, "ORB-30-H", style=label.style_none, color=color.new(color.white, 100), textcolor=colorORB30H, size=getLabelSize())
    if showORB30L and orb30Display and orb30Formed and not na(orb30Low)
        label.delete(labelORB30L)
        labelORB30L := label.new(labelX, orb30Low + tickOffset, "ORB-30-L", style=label.style_none, color=color.new(color.white, 100), textcolor=colorORB30L, size=getLabelSize())

    // Overnight High/Low labels (display only during RTH 9:30-16:00)
    if showOVH and inRTH and not na(ovh)
        label.delete(labelOVH)
        labelOVH := label.new(labelX, ovh + tickOffset, "OVH", style=label.style_none, color=color.new(color.white, 100), textcolor=colorOVH, size=getLabelSize())

    if showOVL and inRTH and not na(ovl)
        label.delete(labelOVL)
        labelOVL := label.new(labelX, ovl + tickOffset, "OVL", style=label.style_none, color=color.new(color.white, 100), textcolor=colorOVL, size=getLabelSize())

    // Open (RTH) label (display only during RTH 9:30-16:00)
    if showRTHO and inRTH and not na(rthOpen)
        label.delete(labelRTHO)
        labelRTHO := label.new(labelX, rthOpen + tickOffset, "Open", style=label.style_none, color=color.new(color.white, 100), textcolor=colorRTHO, size=getLabelSize())

// ===== IB CONFLUENCE ALERT =====
alertcondition(ibConfBull and ibDisplay and not ibDisplay[1], "IB Dual Confluence → High Break", "IB dual confluence: expect HIGH break (~74% pre-noon, ~84% pre-close)")
alertcondition(ibConfBear and ibDisplay and not ibDisplay[1], "IB Dual Confluence → Low Break",  "IB dual confluence: expect LOW break (~74% pre-noon, ~84% pre-close)")