//@version=6
indicator("Chart Pattern Scanner", overlay=true)

// =========================================================================
// INPUTS & SETTINGS
// =========================================================================
grp_settings = "Scanner Settings"
i_tf   = input.timeframe("15", title="Pattern Timeframe", options=["5", "15", "30", "60", "240", "1D", "1W", "1M"], group=grp_settings)
i_pos  = input.string("Bottom Right", title="Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], group=grp_settings)
i_size = input.string("Normal", title="Font Size", options=["Auto", "Tiny", "Small", "Normal", "Large"], group=grp_settings)

grp_filters = "Pattern Filters"
i_atr_len = input.int(14, "ATR Length", minval=5, maxval=50, group=grp_filters)
i_min_body = input.float(0.5, "Min Body (% of ATR)", minval=0.1, maxval=2.0, step=0.1, group=grp_filters, tooltip="Minimum candle body size relative to ATR.")
i_vol_mult = input.float(1.0, "Volume Multiplier", minval=0.5, maxval=3.0, step=0.1, group=grp_filters, tooltip="Volume must exceed avg × this multiplier.")
i_wick_long = input.float(2.0, "Long Wick (×body)", minval=1.0, maxval=5.0, step=0.1, group=grp_filters, tooltip="Wick must be ≥ body × this multiplier.")
i_wick_short = input.float(0.5, "Short Wick (×body)", minval=0.1, maxval=1.0, step=0.1, group=grp_filters, tooltip="Wick must be ≤ body × this multiplier.")
i_body_large = input.float(0.5, "Large Body (% of range)", minval=0.3, maxval=0.9, step=0.05, group=grp_filters, tooltip="For 3-candle patterns: body must be ≥ range × this value.")

// =========================================================================
// TRANSLATE INPUTS TO PINE SCRIPT BUILT-INS
// =========================================================================
get_pos(p) =>
    p == "Top Right" ? position.top_right :
     p == "Top Left" ? position.top_left :
     p == "Bottom Right" ? position.bottom_right :
     p == "Bottom Left" ? position.bottom_left :
     p == "Middle Right" ? position.middle_right : position.middle_left

get_size(s) =>
    s == "Auto" ? size.auto :
     s == "Tiny" ? size.tiny :
     s == "Small" ? size.small :
     s == "Normal" ? size.normal : size.large

// =========================================================================
// FETCH DATA FOR SELECTED TIMEFRAME (with pattern calculation shifted by 1 bar)
// =========================================================================
// Note: Patterns detected on [1] bars ago (shifted by 1) to ensure candle is
// confirmed and prevent repainting. All references shifted: [1]→[2], [0]→[1].
float atr_tf = request.security(syminfo.tickerid, i_tf, ta.atr(i_atr_len), lookahead=barmerge.lookahead_on)
float vol_tf = request.security(syminfo.tickerid, i_tf, volume, lookahead=barmerge.lookahead_on)
float avg_vol_tf = request.security(syminfo.tickerid, i_tf, ta.sma(volume, 20), lookahead=barmerge.lookahead_on)

[b_eng_tf, br_eng_tf, ham_tf, ss_tf, ms_tf, es_tf] = request.security(syminfo.tickerid, i_tf, [
     // Bullish Engulfing (shifted 1): 1-bar-ago red, current green, body engulfs
     close[2] < open[2] and close[1] > open[1] and close[1] >= open[2] and open[1] <= close[2] and math.abs(close[1] - open[1]) > math.abs(close[2] - open[2]) and math.abs(close[1] - open[1]) > atr_tf * i_min_body and vol_tf > avg_vol_tf * i_vol_mult,
     // Bearish Engulfing (shifted 1): 1-bar-ago green, current red, body engulfs
     close[2] > open[2] and close[1] < open[1] and close[1] <= open[2] and open[1] >= close[2] and math.abs(close[1] - open[1]) > math.abs(close[2] - open[2]) and math.abs(close[1] - open[1]) > atr_tf * i_min_body and vol_tf > avg_vol_tf * i_vol_mult,
     // Hammer (shifted 1): small body at top, long lower wick, short upper wick
     math.abs(close[1] - open[1]) > 0 and (math.min(open[1], close[1]) - low[1]) >= (math.abs(close[1] - open[1]) * i_wick_long) and (high[1] - math.max(open[1], close[1])) <= (math.abs(close[1] - open[1]) * i_wick_short) and (high[1] - low[1]) > 0 and math.abs(close[1] - open[1]) > atr_tf * i_min_body and vol_tf > avg_vol_tf * i_vol_mult,
     // Shooting Star (shifted 1): small body at bottom, long upper wick, short lower wick
     math.abs(close[1] - open[1]) > 0 and (high[1] - math.max(open[1], close[1])) >= (math.abs(close[1] - open[1]) * i_wick_long) and (math.min(open[1], close[1]) - low[1]) <= (math.abs(close[1] - open[1]) * i_wick_short) and (high[1] - low[1]) > 0 and math.abs(close[1] - open[1]) > atr_tf * i_min_body and vol_tf > avg_vol_tf * i_vol_mult,
     // Morning Star (shifted 1): 3-candle bottom reversal (red→narrow→green), low below both prior
     close[3] < open[3] and math.abs(close[3] - open[3]) > (high[3] - low[3]) * i_body_large and math.abs(close[2] - open[2]) < math.abs(close[3] - open[3]) * (1 - i_body_large) and close[1] > open[1] and close[1] > (open[3] + close[3]) / 2 and low[2] < low[3] and low[2] < low[1] and math.abs(close[1] - open[1]) > atr_tf * i_min_body and vol_tf > avg_vol_tf * i_vol_mult,
     // Evening Star (shifted 1): 3-candle top reversal (green→narrow→red), high above both prior
     close[3] > open[3] and math.abs(close[3] - open[3]) > (high[3] - low[3]) * i_body_large and math.abs(close[2] - open[2]) < math.abs(close[3] - open[3]) * (1 - i_body_large) and close[1] < open[1] and close[1] < (open[3] + close[3]) / 2 and high[2] > high[3] and high[2] > high[1] and math.abs(close[1] - open[1]) > atr_tf * i_min_body and vol_tf > avg_vol_tf * i_vol_mult
])

// =========================================================================
// DRAW TABLE
// =========================================================================
var tbl = table.new(get_pos(i_pos), 3, 8, border_width=1, border_color=color.new(color.gray, 80), frame_width=1, frame_color=color.new(color.gray, 80), bgcolor=color.new(color.black, 80))

// Helper function for Signals (takes condition and bias: "bullish" or "bearish")
get_signal(cond, bias) =>
    cond ? (bias == "bullish" ? "🟢" : "🔴") : "⚫"

if barstate.islast
    // Headers
    table.cell(tbl, 0, 0, "Pattern", text_color=color.white, bgcolor=color.new(color.blue, 60), text_size=get_size(i_size))
    table.cell(tbl, 1, 0, "Bias", text_color=color.white, bgcolor=color.new(color.blue, 60), text_size=get_size(i_size))
    table.cell(tbl, 2, 0, "Signal", text_color=color.white, bgcolor=color.new(color.blue, 60), text_size=get_size(i_size))

    // Row 1: Bullish Engulfing
    table.cell(tbl, 0, 1, "Bullish Engulfing", text_color=color.white, text_size=get_size(i_size))
    table.cell(tbl, 1, 1, "Bullish", text_color=color.green, text_size=get_size(i_size))
    table.cell(tbl, 2, 1, get_signal(b_eng_tf, "bullish"), text_size=get_size(i_size))

    // Row 2: Bearish Engulfing
    table.cell(tbl, 0, 2, "Bearish Engulfing", text_color=color.white, text_size=get_size(i_size))
    table.cell(tbl, 1, 2, "Bearish", text_color=color.red, text_size=get_size(i_size))
    table.cell(tbl, 2, 2, get_signal(br_eng_tf, "bearish"), text_size=get_size(i_size))

    // Row 3: Hammer
    table.cell(tbl, 0, 3, "Hammer", text_color=color.white, text_size=get_size(i_size))
    table.cell(tbl, 1, 3, "Bullish", text_color=color.green, text_size=get_size(i_size))
    table.cell(tbl, 2, 3, get_signal(ham_tf, "bullish"), text_size=get_size(i_size))

    // Row 4: Shooting Star
    table.cell(tbl, 0, 4, "Shooting Star", text_color=color.white, text_size=get_size(i_size))
    table.cell(tbl, 1, 4, "Bearish", text_color=color.red, text_size=get_size(i_size))
    table.cell(tbl, 2, 4, get_signal(ss_tf, "bearish"), text_size=get_size(i_size))

    // Row 5: Morning Star
    table.cell(tbl, 0, 5, "Morning Star", text_color=color.white, text_size=get_size(i_size))
    table.cell(tbl, 1, 5, "Bullish", text_color=color.green, text_size=get_size(i_size))
    table.cell(tbl, 2, 5, get_signal(ms_tf, "bullish"), text_size=get_size(i_size))

    // Row 6: Evening Star
    table.cell(tbl, 0, 6, "Evening Star", text_color=color.white, text_size=get_size(i_size))
    table.cell(tbl, 1, 6, "Bearish", text_color=color.red, text_size=get_size(i_size))
    table.cell(tbl, 2, 6, get_signal(es_tf, "bearish"), text_size=get_size(i_size))

    // Row 7: Legend (Merged across all 3 columns)
    table.merge_cells(tbl, 0, 7, 2, 7)
    table.cell(tbl, 0, 7, "TF: " + i_tf + "m | 🟢 Bullish | 🔴 Bearish | ⚫ Not Detected", text_color=color.gray, text_size=get_size("Small"), bgcolor=color.new(color.black, 90))
